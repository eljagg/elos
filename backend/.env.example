# ============================================================================
# ELOS - Environment Variables Template
# ============================================================================
# 
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
#
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# Option 1: Connection string (recommended)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/elos

# Option 2: Individual parameters (used if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elos
DB_USER=postgres
DB_PASSWORD=your_password

# Connection pool settings
DB_POOL_MAX=30
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# SSL (set to true for production)
DB_SSL=false

# ----------------------------------------------------------------------------
# JWT Configuration
# ----------------------------------------------------------------------------
# IMPORTANT: Generate secure random strings for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production-64-chars-minimum
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-64-chars-minimum
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ----------------------------------------------------------------------------
# Security Configuration
# ----------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=12
BCRYPT_SALT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION_MINUTES=30
SESSION_TIMEOUT_MINUTES=60

# Rate limiting skip IPs (comma-separated, for monitoring services)
RATE_LIMIT_SKIP_IPS=

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----------------------------------------------------------------------------
# Email Configuration (for notifications)
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@elos.local
EMAIL_FROM_NAME=ELOS System

# ----------------------------------------------------------------------------
# File Upload Configuration
# ----------------------------------------------------------------------------
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# Frontend URL (for email links)
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
