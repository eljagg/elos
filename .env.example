# ===========================================
# ELOS Environment Variables for Railway
# ===========================================
# Copy these to Railway Dashboard → Your Service → Variables

# Database (AUTO-SET by Railway when you add PostgreSQL)
# DATABASE_URL=postgresql://...

# Application
NODE_ENV=production
PORT=3000

# JWT Secrets (REQUIRED - Generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=generate-a-64-character-random-string-here
JWT_REFRESH_SECRET=generate-another-64-character-random-string

# Token Expiration
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (Update with your actual domain)
FRONTEND_URL=https://your-domain.com

# ===========================================
# Email Configuration (Optional but recommended)
# ===========================================
# For Gmail:
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=ELOS <noreply@your-domain.com>
EMAIL_FROM_NAME=ELOS

# ===========================================
# Security Settings (Optional - defaults are fine)
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
PASSWORD_MIN_LENGTH=8
